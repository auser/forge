# Forge environment file — copy to `.env` in your project root and fill in
# what you use. Forge loads .env and .env.local at startup
# (shell env > .env.local > .env). Values are redacted from all logs.
# Lines with empty values are ignored by routing until set.

# Hosted model providers (used by the built-in model registry)
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Router endpoints (usually unnecessary — defaults are local)
# FORGE_ROUTER=laya
# FORGE_ROUTER_URL=http://127.0.0.1:8788/decide
# FORGE_ROUTER_KEY_ENV=

# Model overrides
# FORGE_MODEL=qwen3-coder
# FORGE_MODEL_BASE_URL=http://127.0.0.1:8080/v1
# FORGE_MODEL_KEY_ENV=
